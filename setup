#!/usr/bin/env bash
# setup — bootstrap the /jianghu skill after `git clone`.
#
# Steps:
#   1. ensure bin/* is executable
#   2. R17 width detection (writes config.json:frame_style)
#   3. state init (anchors journey to current breath, no-op if already exists)
#   4. optional tweakcc consent message
#
# Idempotent. Safe to re-run.
#
# Modes:
#   --auto              non-interactive width detection (defaults rich)
#   --no-state-init     skip step 3 (rare)
#
# Env: JIANGHU_HOME, JIANGHU_REPO_ROOT (default = this script's dir)

set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
repo_root="${JIANGHU_REPO_ROOT:-$here}"
bin_dir="$repo_root/bin"

mode_auto=false
do_state_init=true

while [[ $# -gt 0 ]]; do
    case "$1" in
        --auto) mode_auto=true; shift;;
        --no-state-init) do_state_init=false; shift;;
        -h|--help)
            sed -n '2,/^set -euo/p' "$0" | sed -n '/^# /p' | sed 's/^# //'; exit 0;;
        *) printf 'unknown flag: %s\n' "$1" >&2; exit 1;;
    esac
done

printf '\n┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄\n'
printf '   /jianghu  ─  setup\n'
printf '┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄\n\n'

# Step 1 — chmod +x.
chmod +x "$bin_dir"/* "$repo_root"/install.sh "$repo_root"/setup 2>/dev/null || true

# Step 2 — width detection.
if [[ "$mode_auto" == true ]]; then
    fs="$("$bin_dir/jianghu-detect-width.sh" --auto)"
else
    fs="$("$bin_dir/jianghu-detect-width.sh")"
fi
printf '  frame_style: %s\n' "$fs"

# Step 3 — state init (anchors to current breath count).
if [[ "$do_state_init" == true ]]; then
    breath="$("$bin_dir/jianghu-breath" 2>/dev/null || echo 0)"
    [[ "$breath" =~ ^[0-9]+$ ]] || breath=0
    "$bin_dir/jianghu-state" init --breath "$breath" >/dev/null
    printf '  state:       initialized at %s 息\n' "$breath"
fi

# Step 4 — tweakcc consent message.
if command -v tweakcc >/dev/null 2>&1; then
    tw="$(command -v tweakcc)"
    printf '  tweakcc:     %s ✓\n' "$tw"
    printf '  Apply theme: tweakcc  (interactive UI)\n'
    printf '  Theme file:  %s\n' "$repo_root/themes/jianghu-theme.json"
else
    printf '  tweakcc:     not found\n'
    printf '  Optional:    npm i -g tweakcc  (full color theme)\n'
    printf '  Without it:  /jianghu still works, just monochrome.\n'
fi

printf '\n山门已开. 请在 Claude Code 中输入 /jianghu.\n'
printf 'The gate is open. Type /jianghu in Claude Code to begin.\n\n'
